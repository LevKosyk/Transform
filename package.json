{
  "name": "selectcraft",
  "displayName": "SelectCraft — Developer Text Tools",
  "description": "Format and validate JSON, convert JSON to YAML or TypeScript, decode JWT and Base64, and transform URLs, dates, UUIDs, and text in VS Code.",
  "version": "1.0.0",
  "publisher": "levkosyk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LevKosyk/SelectCraft"
  },
  "homepage": "https://github.com/LevKosyk/SelectCraft#readme",
  "bugs": {
    "url": "https://github.com/LevKosyk/SelectCraft/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "json formatter",
    "json minify",
    "json validator",
    "json to yaml",
    "yaml to json",
    "json to typescript",
    "jwt decoder",
    "base64 encode",
    "base64 decode",
    "url encode",
    "url decode",
    "url parser",
    "query string",
    "unix timestamp",
    "date converter",
    "uuid generator",
    "uuid validator",
    "case converter",
    "camel case",
    "snake case",
    "kebab case",
    "text transform",
    "developer tools",
    "offline tools",
    "vscode json formatter",
    "json pretty print",
    "vscode jwt decoder",
    "typescript interface"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "activationEvents": [],
  "scripts": {
    "build": "tsc --noEmit -p . && node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\" && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "watch": "tsc -w -p .",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "npm run build && tsc --noEmit --target ES2022 --module CommonJS --moduleResolution Node --strict --esModuleInterop --skipLibCheck test/integration.ts && esbuild test/integration.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/integration.js && node scripts/run-integration.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "contributes": {
    "commands": [
      {
        "command": "selectcraft.smartAction",
        "title": "Smart Action",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.formatJson",
        "title": "Format JSON",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.minifyJson",
        "title": "Minify JSON",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.validateJson",
        "title": "Validate JSON",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.jsonToYaml",
        "title": "JSON to YAML",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.yamlToJson",
        "title": "YAML to JSON",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.jsonToTypescript",
        "title": "JSON to TypeScript",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.decodeJwt",
        "title": "Decode JWT",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.copyJwtPayload",
        "title": "Copy JWT Payload",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.base64Encode",
        "title": "Base64 Encode",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.base64Decode",
        "title": "Base64 Decode",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.urlEncode",
        "title": "URL Encode",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.urlDecode",
        "title": "URL Decode",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.parseUrl",
        "title": "Parse URL",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.parseQuery",
        "title": "Parse Query Parameters",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.timestampToDate",
        "title": "Timestamp to Date",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.copyIsoDate",
        "title": "Copy ISO Date",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.dateToTimestamp",
        "title": "Date to Timestamp",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.generateUuid",
        "title": "Generate UUID v4",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.validateUuid",
        "title": "Validate UUID",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.camelCase",
        "title": "camelCase",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.pascalCase",
        "title": "PascalCase",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.snakeCase",
        "title": "snake_case",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.kebabCase",
        "title": "kebab-case",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.constantCase",
        "title": "CONSTANT_CASE",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.lowercase",
        "title": "lowercase",
        "category": "SelectCraft"
      },
      {
        "command": "selectcraft.uppercase",
        "title": "UPPERCASE",
        "category": "SelectCraft"
      }
    ],
    "keybindings": [
      {
        "command": "selectcraft.smartAction",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "selectcraft.smartAction",
          "group": "9_cutcopypaste@1",
          "when": "editorHasSelection"
        },
        {
          "submenu": "selectcraft.editorMenu",
          "group": "9_cutcopypaste@2",
          "when": "editorHasSelection"
        }
      ],
      "selectcraft.editorMenu": [
        {
          "command": "selectcraft.formatJson",
          "group": "1_json@1"
        },
        {
          "command": "selectcraft.minifyJson",
          "group": "1_json@2"
        },
        {
          "command": "selectcraft.decodeJwt",
          "group": "2_encoding@1"
        },
        {
          "command": "selectcraft.base64Decode",
          "group": "2_encoding@2"
        }
      ]
    },
    "configuration": {
      "title": "SelectCraft",
      "properties": {
        "selectcraft.json.indentation": {
          "type": "string",
          "enum": [
            "2",
            "4",
            "tab"
          ],
          "default": "2",
          "description": "Indentation used for formatted JSON and generated TypeScript."
        },
        "selectcraft.smartAction.clipboardFallback": {
          "type": "boolean",
          "default": true,
          "description": "Read the clipboard when no text is selected."
        },
        "selectcraft.defaultResultBehavior": {
          "type": "string",
          "enum": [
            "replace",
            "copy",
            "ask"
          ],
          "default": "replace",
          "description": "How transformation results are delivered."
        }
      }
    },
    "submenus": [
      {
        "id": "selectcraft.editorMenu",
        "label": "SelectCraft"
      }
    ]
  }
}
