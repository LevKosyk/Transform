    "keybindings": [
      {
        "command": "transform.smartAction",
        "key": "ctrl+alt+x",
        "mac": "alt+cmd+x",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "transform.smartAction",
          "group": "9_cutcopypaste@1",
          "when": "editorHasSelection"
        },
        {
          "submenu": "transform.editorMenu",
          "group": "9_cutcopypaste@2",
          "when": "editorHasSelection"
        },
        {
          "command": "transform.copyJsonPath",
          "group": "9_cutcopypaste@3",
          "when": "editorLangId =~ /^jsonc?$/"
        }
      ],
      "transform.editorMenu": [
        {
          "command": "transform.formatJson",
          "group": "1_json@1"
        },
        {
          "command": "transform.minifyJson",
          "group": "1_json@2"
        },
        {
          "command": "transform.decodeJwt",
          "group": "2_encoding@1"
        },
        {
          "command": "transform.base64Decode",
          "group": "2_encoding@2"
        }
      ]
    },
    "configuration": {
      "title": "Transform",
      "properties": {
        "transform.json.indentation": {
          "type": "string",
          "enum": [
            "2",
            "4",
            "tab"
          ],
          "default": "2",
          "description": "Indentation used for formatted JSON and generated TypeScript."
        },
        "transform.smartAction.clipboardFallback": {
          "type": "boolean",
          "default": true,
          "description": "Read the clipboard when no text is selected."
        },
        "transform.defaultResultBehavior": {
          "type": "string",
          "enum": [
            "replace",
            "copy",
            "ask",
            "preview"
          ],
          "default": "replace",
          "description": "How transformation results are delivered. Preview opens a diff and asks before applying the result."
        },
        "transform.typescript.kind": {
          "type": "string",
          "enum": [
            "interface",
            "type"
          ],
          "default": "interface",
          "description": "Declaration style used when generating TypeScript from JSON."
        },
        "transform.codegen.rootName": {
          "type": "string",
          "default": "Root",
          "description": "Name for the root type generated from JSON in TypeScript, Zod, Go, Python, and Rust."
        },
        "transform.typescript.export": {
          "type": "boolean",
          "default": false,
          "description": "Add the export keyword to generated TypeScript declarations."
        },
        "transform.codegen.optionalProperties": {
          "type": "boolean",
          "default": false,
          "description": "Mark every generated property as optional in TypeScript, Zod, Go, Python, and Rust."
        },
        "transform.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show decoded values when hovering Unix timestamps, JWTs, and Base64 strings."
        }
      }
    },
    "submenus": [
      {
        "id": "transform.editorMenu",
        "label": "Transform"
      }
    ]
  }
}
