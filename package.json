{
  "name": "selectcraft",
  "displayName": "Transform — JSON, JWT & Text Tools",
  "description": "Format JSON, generate JSON Schema and TypeScript, convert YAML, decode JWT and Base64, and transform URLs, dates, UUIDs, and text offline in VS Code.",
  "version": "1.0.0",
  "publisher": "levkosyk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LevKosyk/Transform"
  },
  "homepage": "https://github.com/LevKosyk/Transform#readme",
  "bugs": {
    "url": "https://github.com/LevKosyk/Transform/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "json formatter",
    "sort json keys",
    "format json",
    "json pretty print",
    "json minifier",
    "json validator",
    "json to yaml",
    "yaml to json",
    "json to typescript",
    "typescript interface generator",
    "json schema generator",
    "json to json schema",
    "jwt decoder",
    "jwt viewer",
    "base64 encoder",
    "base64 decoder",
    "url encoder",
    "url decoder",
    "url parser",
    "query string parser",
    "unix timestamp converter",
    "date converter",
    "uuid generator",
    "uuid validator",
    "case converter",
    "camel case",
    "snake case",
    "kebab case",
    "vscode developer tools",
    "developer text tools"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "activationEvents": [],
  "scripts": {
    "build": "tsc --noEmit -p . && node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\" && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "watch": "tsc -w -p .",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "npm run build && tsc --noEmit --target ES2022 --module CommonJS --moduleResolution Node --strict --esModuleInterop --skipLibCheck test/integration.ts && esbuild test/integration.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/integration.js && node scripts/run-integration.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.6",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "contributes": {
    "commands": [
      {
        "command": "selectcraft.smartAction",
        "title": "Smart Action",
        "category": "Transform"
      },
      {
        "command": "selectcraft.formatJson",
        "title": "Format JSON",
        "category": "Transform"
      },
      {
        "command": "selectcraft.minifyJson",
        "title": "Minify JSON",
        "category": "Transform"
      },
      {
        "command": "selectcraft.sortJsonKeys",
        "title": "Sort JSON Keys",
        "category": "Transform"
      },
      {
        "command": "selectcraft.validateJson",
        "title": "Validate JSON",
        "category": "Transform"
      },
      {
        "command": "selectcraft.jsonToYaml",
        "title": "JSON to YAML",
        "category": "Transform"
      },
      {
        "command": "selectcraft.yamlToJson",
        "title": "YAML to JSON",
        "category": "Transform"
      },
      {
        "command": "selectcraft.jsonToTypescript",
        "title": "JSON to TypeScript",
        "category": "Transform"
      },
      {
        "command": "selectcraft.jsonToSchema",
        "title": "JSON to JSON Schema",
        "category": "Transform"
      },
      {
        "command": "selectcraft.decodeJwt",
        "title": "Decode JWT",
        "category": "Transform"
      },
      {
        "command": "selectcraft.copyJwtPayload",
        "title": "Copy JWT Payload",
        "category": "Transform"
      },
      {
        "command": "selectcraft.base64Encode",
        "title": "Base64 Encode",
        "category": "Transform"
      },
      {
        "command": "selectcraft.base64Decode",
        "title": "Base64 Decode",
        "category": "Transform"
      },
      {
        "command": "selectcraft.urlEncode",
        "title": "URL Encode",
        "category": "Transform"
      },
      {
        "command": "selectcraft.urlDecode",
        "title": "URL Decode",
        "category": "Transform"
      },
      {
        "command": "selectcraft.parseUrl",
        "title": "Parse URL",
        "category": "Transform"
      },
      {
        "command": "selectcraft.parseQuery",
        "title": "Parse Query Parameters",
        "category": "Transform"
      },
      {
        "command": "selectcraft.timestampToDate",
        "title": "Timestamp to Date",
        "category": "Transform"
      },
      {
        "command": "selectcraft.copyIsoDate",
        "title": "Copy ISO Date",
        "category": "Transform"
      },
      {
        "command": "selectcraft.dateToTimestamp",
        "title": "Date to Timestamp",
        "category": "Transform"
      },
      {
        "command": "selectcraft.generateUuid",
        "title": "Generate UUID v4",
        "category": "Transform"
      },
      {
        "command": "selectcraft.validateUuid",
        "title": "Validate UUID",
        "category": "Transform"
      },
      {
        "command": "selectcraft.camelCase",
        "title": "camelCase",
        "category": "Transform"
      },
      {
        "command": "selectcraft.pascalCase",
        "title": "PascalCase",
        "category": "Transform"
      },
      {
        "command": "selectcraft.snakeCase",
        "title": "snake_case",
        "category": "Transform"
      },
      {
        "command": "selectcraft.kebabCase",
        "title": "kebab-case",
        "category": "Transform"
      },
      {
        "command": "selectcraft.constantCase",
        "title": "CONSTANT_CASE",
        "category": "Transform"
      },
      {
        "command": "selectcraft.lowercase",
        "title": "lowercase",
        "category": "Transform"
      },
      {
        "command": "selectcraft.uppercase",
        "title": "UPPERCASE",
        "category": "Transform"
      }
    ],
    "keybindings": [
      {
        "command": "selectcraft.smartAction",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "selectcraft.smartAction",
          "group": "9_cutcopypaste@1",
          "when": "editorHasSelection"
        },
        {
          "submenu": "selectcraft.editorMenu",
          "group": "9_cutcopypaste@2",
          "when": "editorHasSelection"
        }
      ],
      "selectcraft.editorMenu": [
        {
          "command": "selectcraft.formatJson",
          "group": "1_json@1"
        },
        {
          "command": "selectcraft.minifyJson",
          "group": "1_json@2"
        },
        {
          "command": "selectcraft.decodeJwt",
          "group": "2_encoding@1"
        },
        {
          "command": "selectcraft.base64Decode",
          "group": "2_encoding@2"
        }
      ]
    },
    "configuration": {
      "title": "Transform",
      "properties": {
        "selectcraft.json.indentation": {
          "type": "string",
          "enum": [
            "2",
            "4",
            "tab"
          ],
          "default": "2",
          "description": "Indentation used for formatted JSON and generated TypeScript."
        },
        "selectcraft.smartAction.clipboardFallback": {
          "type": "boolean",
          "default": true,
          "description": "Read the clipboard when no text is selected."
        },
        "selectcraft.defaultResultBehavior": {
          "type": "string",
          "enum": [
            "replace",
            "copy",
            "ask",
            "preview"
          ],
          "default": "replace",
          "description": "How transformation results are delivered. Preview opens a diff and asks before applying the result."
        },
        "selectcraft.typescript.kind": {
          "type": "string",
          "enum": [
            "interface",
            "type"
          ],
          "default": "interface",
          "description": "Declaration style used when generating TypeScript from JSON."
        },
        "selectcraft.typescript.rootName": {
          "type": "string",
          "default": "Root",
          "description": "Name for the root declaration generated from JSON."
        },
        "selectcraft.typescript.export": {
          "type": "boolean",
          "default": false,
          "description": "Add the export keyword to generated TypeScript declarations."
        },
        "selectcraft.typescript.optionalProperties": {
          "type": "boolean",
          "default": false,
          "description": "Mark every generated TypeScript property as optional."
        }
      }
    },
    "submenus": [
      {
        "id": "selectcraft.editorMenu",
        "label": "Transform"
      }
    ]
  }
}
