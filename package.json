{
  "name": "transform-tools",
  "displayName": "Transform — JSON Formatter, JWT Decoder & Dev Tools",
  "description": "JSON formatter & validator, JWT decoder, Base64 and timestamp hovers, JSON to TypeScript, Zod, Go, Python & Rust, YAML/CSV/TOML converter, UUID, hash and case tools. 100% offline.",
  "version": "1.0.0",
  "publisher": "levkosyk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LevKosyk/Transform"
  },
  "homepage": "https://github.com/LevKosyk/Transform#readme",
  "bugs": {
    "url": "https://github.com/LevKosyk/Transform/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "json formatter",
    "json",
    "jwt decoder",
    "jwt",
    "base64",
    "json to typescript",
    "json to zod",
    "json to go",
    "json to python",
    "json schema",
    "yaml to json",
    "json to yaml",
    "json to csv",
    "csv to json",
    "toml",
    "jsonpath",
    "prettify json",
    "escape json",
    "timestamp converter",
    "epoch",
    "uuid generator",
    "json validator",
    "hash",
    "sha256",
    "case converter",
    "camel case",
    "snake case",
    "url encode",
    "developer tools",
    "json beautifier"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#17181C",
    "theme": "dark"
  },
  "pricing": "Free",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "scripts": {
    "build": "tsc --noEmit -p . && node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\" && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "watch": "tsc -w -p .",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "npm run build && tsc --noEmit --target ES2022 --module CommonJS --moduleResolution Node --strict --esModuleInterop --skipLibCheck test/integration.ts && esbuild test/integration.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/integration.js && node scripts/run-integration.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "smol-toml": "^1.9.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^26.6.3",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "globals": "^17.12.0",
    "ovsx": "^1.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
